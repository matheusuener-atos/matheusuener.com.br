// O site da Atos (atos.dev.br) e a conta Atos ("Entrar com Atos"), num Worker
// so: a pasta public/ e o worker/. Publicado com "npx wrangler deploy".
//
// Segredos (npx wrangler secret put <NOME>):
//   ATOS_CHAVE      a JWK privada que assina os id_token (tools/gerar-chave.mjs)
//   RESEND_API_KEY  o envio dos codigos por e-mail (dominio atos.dev.br verificado no Resend)
{
  "name": "atos",
  "compatibility_date": "2026-09-25",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Tudo passa pelo Worker: os cabecalhos de seguranca e o 301 de
    // matheusuener.com.br saem dele.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "atos.dev.br", "custom_domain": true },
    { "pattern": "www.atos.dev.br", "custom_domain": true }
    // matheusuener.com.br (o 301 para atos.dev.br ja esta no worker/index.js):
    // entra aqui depois que os registros DNS do GitHub Pages sairem do
    // Cloudflare - com eles, o deploy recusa o dominio (codigo 100117).
    // { "pattern": "matheusuener.com.br", "custom_domain": true },
    // { "pattern": "www.matheusuener.com.br", "custom_domain": true }
  ],
  // As contas: o MESMO namespace do KV APOIOS do Worker do PAVLVS (paulus.ia.br).
  // As chaves "id:*" (as contas, como o PAVLVS ja as criava) sao das duas; as
  // "atos:*" (sessoes, permissoes, codigos e tokens) so deste Worker.
  "kv_namespaces": [{ "binding": "CONTAS", "id": "c8011a70799b40b0b3215f4a01b2d28c" }],
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true },
  // A Atos Cobranca (docs/COBRANCA.md, worker/cobranca/): um objeto por cliente (a Conta Atos), com os dados
  // fiscais, as assinaturas, as compras e os direitos - o registro do dinheiro, com consistencia forte.
  "durable_objects": { "bindings": [{ "name": "CLIENTES", "class_name": "ClienteCobranca" }] },
  "migrations": [{ "tag": "v1-clientes-cobranca", "new_sqlite_classes": ["ClienteCobranca"] }],
  // O app "Atos Cobranca" no Mercado Pago (6924335552095997). Segredos (npx wrangler secret put):
  //   MP_ACCESS_TOKEN    o Access Token de producao do app (cobrar, assinar, devolver)
  //   MP_WEBHOOK_SECRET  a assinatura secreta do webhook (o aviso em https://atos.dev.br/api/mp/aviso)
  // MP_PUBLIC_KEY e a Public Key do mesmo app (nao e segredo; vai ao navegador por /api/mp-config).
  // PRODUTOS_ABERTOS: os produtos que ja vendem pela Atos ("pavlvs,..."); vazio = nenhum cobra ainda.
  "vars": {
    "APP_URL": "https://atos.dev.br",
    "MP_PUBLIC_KEY": "APP_USR-0bb20e6b-f846-4b8e-a267-12bfc8c7fc1a",
    "PRODUTOS_ABERTOS": ""
  },
  // O Worker de teste: npx wrangler deploy --env teste -> atos-teste.<conta>.workers.dev. As credenciais da aba
  // Teste do app Atos Cobranca (nenhum dinheiro de verdade), as vendas abertas so aqui, e os eventos num receptor
  // interno (worker/cobranca/eventos.js, AMBIENTE "teste"): um pagamento de teste nunca libera plano no PAVLVS.
  // As contas sao as mesmas (o mesmo KV): entra-se com a Conta Atos e a senha. Os objetos de cobranca sao
  // outros (cada Worker tem os seus). Segredos proprios, com --env teste: MP_ACCESS_TOKEN (o de teste),
  // MP_WEBHOOK_SECRET e EVENTOS_SEGREDO_PAVLVS (um qualquer, diferente do de producao).
  "env": {
    "teste": {
      "name": "atos-teste",
      "workers_dev": true,
      "routes": [],
      "kv_namespaces": [{ "binding": "CONTAS", "id": "c8011a70799b40b0b3215f4a01b2d28c" }],
      "ratelimits": [{ "name": "LIMITE", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }],
      "durable_objects": { "bindings": [{ "name": "CLIENTES", "class_name": "ClienteCobranca" }] },
      "vars": {
        "AMBIENTE": "teste",
        "APP_URL": "https://atos.dev.br",
        "MP_PUBLIC_KEY": "APP_USR-8eddac59-2852-455f-8b12-04f7761ff00b",
        "PRODUTOS_ABERTOS": "pavlvs",
        // O comprador de teste da conta (MLB, id 3701347744): o pagador de todo pagamento daqui.
        "MP_PAGADOR_TESTE": "test_user_4004064182913175927@testuser.com"
      }
    }
  }
}
